# PostgreSQL connection. For local development run `npm run db:local` (port 5433).
DATABASE_URL="postgresql://mil:mil_local_dev@localhost:5433/mil_hybrid?schema=public"
# Direct connection used by migrations (Neon/pgbouncer: the non-pooled URL). Same as DATABASE_URL locally.
DATABASE_URL_UNPOOLED="postgresql://mil:mil_local_dev@localhost:5433/mil_hybrid?schema=public"
# Used by integration tests only — this database is truncated by the test suite.
TEST_DATABASE_URL="postgresql://mil:mil_local_dev@localhost:5433/mil_hybrid_test?schema=public"

# Session cookie signing/rotation secret (32+ random chars). Generate: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"
# Session lifetime in hours
SESSION_TTL_HOURS=12

# Private file storage for supporting documents (never served from /public)
UPLOAD_DIR="./storage/uploads"
UPLOAD_MAX_MB=5

# Email adapter: "none" (in-app only) or "console" (logs emails to stdout).
# Add an SMTP/Resend adapter in src/server/adapters/email.ts to send real email.
EMAIL_ADAPTER="none"

# Shared secret for POST /api/cron (deadline reminders, shortfall detection, escalation)
CRON_SECRET="change-me"

# Public base URL used in notification links / emails
APP_URL="http://localhost:3000"

# File storage backend: "disk" (local) or "db" (stores files in PostgreSQL; default on Vercel)
STORAGE_DRIVER="disk"

# AES-256-GCM key for sensitive personal data (NIK, NPWP, bank account). 32 bytes, base64: openssl rand -base64 32
# Back it up securely — without it encrypted values cannot be read.
DATA_ENCRYPTION_KEY="change-me"
